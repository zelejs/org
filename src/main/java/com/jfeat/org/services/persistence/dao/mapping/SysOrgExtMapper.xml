<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jfeat.org.services.persistence.dao.SysOrgExtMapper">
    <select id="findById" resultType="com.jfeat.org.services.persistence.model.SysOrgExt">
        select * from t_sys_org_ext where id = #{id} and delete_flag = 0
    </select>

    <select id="findByExtOrgId" resultType="com.jfeat.org.services.persistence.model.SysOrgExt">
        select * from t_sys_org_ext where ext_org_id = #{extOrgId} and delete_flag = 0
    </select>
</mapper>