##########################################################
##################  所有profile共有的配置  #################
##########################################################

###################  项目启动端口  ###################
server:
  port: 8080
  ssl:
    enabled: false
    key-store: classpath:sb.keystore
    key-store-password: changeme
    key-store-type: JKS
    key-alias: sbkey
#https://my.oschina.net/kingchen8080/blog/994367

###################  jwt配置  ###################
jwt:
  encoded-key: L7A/6zARSkK1j7Vd5SDD9pSSqZlqF7mAhiOgRbgv9Smce6tf4cJnvKOjtKPxNNnWQj+2lQEScm3XIUjhW+YVZg==
  #tll-mills:
  #token-type: Bearer
  #enable-attempt-login: false

###################  spring配置  ###################
spring:
  profiles:
    active: dev
  mvc:
    static-path-pattern: /static/**
    view:
      prefix: /WEB-INF/view
  http:
    encoding:
      force: true
      charset: UTF-8
      enabled: true
    converters:
      preferred-json-mapper: fastjson
  dubbo: #dubbo配置
    application:
      name: resources-server-1 #唯一应用名称，需修改
    registry:
      address: zookeeper://zero.zele.pro:2181 #服务注册中心地址
    scan: com.jfeat #扫包路径


###################  mybatis-plus配置  ###################
mybatis-plus:
  mapper-locations: classpath*:com/jfeat/**/mapping/*.xml
  type-aliases-package: com.jfeat.**.model
  global-config:
    id-type: 2  #0:数据库ID自增   1:用户输入id   2:全局唯一id(IdWorker)   3:全局唯一ID(uuid)  4: 该类型为未设置主键类型(none)
    db-column-underline: true
    refresh-mapper: true
    logic-delete-value: -1
    logic-not-delete-value: 1
  configuration:
    map-underscore-to-camel-case: true
    cache-enabled: true #配置的缓存的全局开关
    lazyLoadingEnabled: true #延时加载的开关
    multipleResultSetsEnabled: true #开启的话，延时加载一个属性时会加载该对象全部属性，否则按需加载属性
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl #打印sql语句,调试用

###################  SpringDoc OpenAPI 配置  ###################
springdoc:
  api-docs:
    path: /api-docs  # OpenAPI JSON 文档路径
  swagger-ui:
    path: /swagger-ui.html  # Swagger UI 访问路径
    enabled: true  # 启用 Swagger UI
    tags-sorter: alpha  # 按字母顺序排序标签
    operations-sorter: alpha  # 按字母顺序排序操作
  show-actuator: false  # 不显示 actuator 端点
  default-flat-param-object: true  # 展平参数对象

auth-server: http://106.12.212.64:9999/uaa #授权中心地址
security:
  basic:
    enabled: false
  oauth2:
    client: #资源服务器的client-id、client-secret用于basic签名，统一配置就好，不用修改
      client-id: resource-server
      client-secret: secret
      access-token-uri: ${auth-server}/oauth/token #用于获取token
      user-authorization-uri: ${auth-server}/oauth/authorize #用于授权
    resource:
      token-info-uri: ${auth-server}/oauth/check_token #用于检查token有效性

---

##########################################################
###################  开发环境的profile  ###################
##########################################################
spring:
  config:
    activate:
      on-profile: dev
  datasource:
      url: jdbc:mysql://192.168.3.239/eav?useSSL=false&autoReconnect=true&useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull
      username: root
      password: root
      filters: log4j,wall,mergeStat
      sql-script-encoding: UTF-8
      schema: classpath*:sql/*-schema.sql
      data: classpath*:sql/*-data.sql
      initialize: false

logging:
  level: debug
  file: logs/access.log

---

##########################################################
###################  正式环境的profile  ###################
##########################################################
spring:
  config:
    activate:
      on-profile: produce
  datasource:
      url: jdbc:mysql://127.0.0.1:3306/sbaccount?autoReconnect=true&useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull
      username: root
      password: root
      filters: log4j,wall,mergeStat

logging:
  level: warn
  file: logs/access.log